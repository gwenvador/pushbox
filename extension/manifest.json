{
  "manifest_version": 3,
  "name": "Pushbox",
  "version": "1.0.1",
  "description": "Send text, links and files between your devices, and see your phone's notifications.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pushbox"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "notifications",
    "contextMenus",
    "identity",
    "alarms",
    "downloads",
    "offscreen",
    "activeTab",
    "unlimitedStorage",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ]
}
