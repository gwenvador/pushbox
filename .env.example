# Public URL (required with OIDC: the redirect URI is PUBLIC_URL/auth/callback).
PUBLIC_URL=https://push.example.com

# OIDC sign-in (Pocket ID, Authelia, Authentik, Keycloak…).
OIDC_ISSUER=https://pocketid.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Pocket ID
# Who may sign in (comma-separated). If both are empty, the first account
# that signs in becomes the owner and is the only one accepted afterwards.
OIDC_ALLOWED_EMAILS=
OIDC_ALLOWED_GROUPS=

# Optional password sign-in. Leave empty to disable it (OIDC only).
PUSHBOX_PASSWORD=

# Contact for Web Push services (any mailto: or https: URL you own).
VAPID_SUBJECT=mailto:you@example.com
# Max file size per upload, in MB.
MAX_UPLOAD_MB=1024
# Delete pushes and files older than N days (0 = keep forever).
RETENTION_DAYS=0
